# Copy to packages/mobile/.env.local and fill in. Real values are never committed.
# Only public values go here: everything prefixed EXPO_PUBLIC_ ends up in the app bundle.
# Server secrets (LLM keys, service-role key, push credentials) live in Supabase function
# secrets, NOT in this file. See docs/08-quality.md section 8.7.

# --- Mobile (public by design) ---
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=
# Leave empty to disable the integration entirely.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- App identity (read by packages/mobile/app.config.ts; rename = change these) ---
APP_NAME=Cadence
APP_SLUG=cadence
APP_SCHEME=cadence
APP_BUNDLE_ID=com.example.cadence

# --- Build-time only (EAS secrets, never bundled) ---
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# EXPO_TOKEN=
