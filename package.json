{
  "name": "cadence-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Cadence (working name) - AI-powered productivity app. See docs/.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "mobile": "pnpm --filter @cadence/mobile start",
    "mobile:android": "pnpm --filter @cadence/mobile android",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "functions:serve": "supabase functions serve",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eas-cli": "^27.10.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "supabase": "3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
